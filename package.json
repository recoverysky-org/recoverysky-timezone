{
  "name": "recoverysky-timezone",
  "version": "1.0.0",
  "description": "",
  "author": "Pippa and Jenova",
  "type": "commonjs",
  "main": "dist/server.js",
  "keywords": [],
  "license": "ISC",
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "dev": "ts-node-dev --respawn src/index.ts",
    "make": "pnpm build && pnpm docker:build && pnpm docker:tag && pnpm docker:push",
    "build": "tsup",
    "postbuild": "copyfiles -u 1 \"src/server/scripts/**/*\" \"src/server/config.*.tz\" dist && chmod +x dist/server/scripts/*.sh",
    "docker:build": "docker buildx build --platform linux/arm64 -t recoverysky-timezone:local .",
    "docker:run": "docker run -p 3838:3838 recoverysky-timezone:local",
    "docker:tag": "docker tag recoverysky-timezone:local 376129859732.dkr.ecr.${AWS_REGION}.amazonaws.com/recoverysky-timezone:latest",
    "docker:push": "docker push 376129859732.dkr.ecr.${AWS_REGION}.amazonaws.com/recoverysky-timezone:latest",
    "start": "node dist/server/index.js start",
    "start:debug": "node dist/server/index.js start --debug",
    "test": "jest",
    "test:watch": "jest --watch",
    "tz:update": "npx tzdata-update"
  },
  "dependencies": {
    "@types/yargs": "^17.0.33",
    "bson-objectid": "^2.0.4",
    "dotenv": "^16.5.0",
    "express": "^4.19.2",
    "lodash": "^4.17.21",
    "timezonecomplete": "^5.14.1",
    "ts-rust-result": "^1.0.0",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@aws-sdk/client-secrets-manager": "^3.830.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.17",
    "@types/luxon": "^3.6.2",
    "@types/node": "^24.0.3",
    "copyfiles": "^2.4.1",
    "drizzle-kit": "^0.31.1",
    "drizzle-orm": "^0.44.2",
    "jest": "^30.0.0",
    "jose": "^6.0.11",
    "nodemon": "^3.1.10",
    "pg": "^8.16.0",
    "rollup": "^4.43.0",
    "rollup-plugin-dts": "^6.2.1",
    "rxdb": "^16.15.0",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "typescript-json-schema": "^0.65.1"
  }
}